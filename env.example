# PayPal sandbox credentials, from developer.paypal.com.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Channel3, from trychannel3.com/developers. Hackathon promo code: PAYPAL-HACKATHON-2026.
CHANNEL3_API_KEY=

# The assistant. With no key, the exchange still runs without a model.
OPENAI_API_KEY=

# Optional: another model for the assistant.
# OPENAI_MODEL=gpt-5.4-mini

# Optional: limits for a public demo (lib/guard.ts).
# AI_CALLS_PER_VISITOR=70
# AI_CALLS_PER_DAY=140
# Reasoning effort sent to the model. With tools on Chat Completions, gpt-5.4-mini only takes 'none' (the default).
# OPENAI_REASONING_EFFORT=none
# SHOP_CALLS_PER_VISITOR=150
# SHOP_CALLS_PER_DAY=1200
# HOLDS_PER_DAY=600
